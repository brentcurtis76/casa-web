# =============================================================================
# CASA web (Vite SPA) — environment variables
#
# Copy this file to .env.local for local development (never commit .env.local).
#
# EVERYTHING WITH THE VITE_ PREFIX IS PUBLIC: Vite inlines it into the browser
# bundle. Only the Supabase anon/publishable key belongs here.
#
# NEVER put a service_role key, an sb_secret_* key, a database password, or any
# third-party API key (GOOGLE_AI_API_KEY, ANTHROPIC_API_KEY, RESEND_API_KEY,
# OPENAI_API_KEY, TWILIO_*, SPOTIFY_CLIENT_SECRET, ...) in a VITE_ variable or
# in any .env file of this app. Those are Edge Function secrets, set only with
# `supabase secrets set NAME=...` on the CASA project (ref in supabase/config.toml).
# ENFORCED BEFORE BUNDLING: vite.config.ts validates both variables in a config
# hook (scripts/security/vite-supabase-env-guard.ts). `vite dev` and `vite build`
# abort before any asset is emitted unless VITE_SUPABASE_URL is exactly the hosted
# CASA project URL (or a supported local URL) and VITE_SUPABASE_ANON_KEY is the
# CASA anon JWT or an sb_publishable_* key. service_role, sb_secret_*, sbp_* and
# keys of any other project are refused. The app re-validates at runtime
# (src/integrations/supabase/config.ts) as defense in depth.
# =============================================================================

# ── CASA Development (your machine, .env.local) ──────────────────────────────
# Option A — local Supabase stack (`supabase start`; values printed by `supabase status`):
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<anon-key-printed-by-supabase-status>
# Option B — hosted CASA project (anon/publishable key from Supabase → Settings → API):
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-or-publishable-key>

# ── CASA Preview (Vercel → Settings → Environment Variables → "Preview") ─────
# Branch/PR deployments. Use the anon/publishable key of the project previews
# should talk to (normally the same CASA project). Never a secret key.
#   VITE_SUPABASE_URL      = https://<your-project-ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY = <anon-or-publishable-key-for-preview>

# ── CASA Production (Vercel → Settings → Environment Variables → "Production") ─
# Deployments from `main`. Both variables are REQUIRED: without them (or with a
# wrong-project / privileged value) `vite build` fails before bundling.
#   VITE_SUPABASE_URL      = https://<your-project-ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY = <anon-or-publishable-key-for-production>
